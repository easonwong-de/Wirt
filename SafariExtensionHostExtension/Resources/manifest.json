{
	"manifest_version": 3,
	"name": "Safari Extension Host",
	"version": "1.0.0",
	"description": "Host and transportation layer for Chrome and Firefox extensions in Safari",
	"permissions": ["nativeMessaging", "storage", "tabs", "webNavigation"],
	"host_permissions": ["<all_urls>"],
	"action": {
		"default_popup": "popup.html"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["bootstrapper.js"],
			"run_at": "document_start",
			"all_frames": true
		}
	]
}
