{
	"tasks": [
		{
			"command": "swift-format format -i -r Wirt WirtExtension && (bun --cwd WirtExtension/WebExtension prettier --write . 2>&1 | grep -v '(unchanged)' || true)",
			"label": "Format Code",
			"problemMatcher": [],
			"type": "shell"
		},
		{
			"command": "xcodebuild -project Wirt.xcodeproj -scheme Wirt -configuration Debug -destination 'platform=macOS' build",
			"group": { "isDefault": true, "kind": "build" },
			"label": "Build (Debug)",
			"problemMatcher": ["$xcode"],
			"type": "shell"
		},
		{
			"command": "xcodebuild -project Wirt.xcodeproj -scheme Wirt -configuration Release -destination 'platform=macOS' build",
			"group": "build",
			"label": "Build (Release)",
			"problemMatcher": ["$xcode"],
			"type": "shell"
		},
		{
			"command": "bash scripts/cleanup.sh",
			"label": "Cleanup",
			"problemMatcher": [],
			"type": "shell"
		}
	],
	"version": "2.0.0"
}
